{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spike.local/schemas/v1/proof-package.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "spike-proof"
    },
    "version": {
      "const": 1
    },
    "exported_utc": {
      "type": "string"
    },
    "spike": {
      "type": "string"
    },
    "included": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "chat",
          "calls",
          "files",
          "providers",
          "settings",
          "environment"
        ]
      }
    },
    "chat": {
      "type": "object"
    },
    "verification": {
      "type": "object",
      "description": "Always not_independently_verified: integrity since export, not proof that the work is correct.",
      "properties": {
        "status": {
          "const": "not_independently_verified"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "machine": {
      "type": "object"
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "settings": {
      "type": "object"
    }
  },
  "required": [
    "format",
    "version",
    "exported_utc",
    "spike",
    "included"
  ],
  "additionalProperties": false
}
